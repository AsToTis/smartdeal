# ==========================================================
# Smart Deal backend - ตัวอย่างไฟล์ .env (คัดลอกเป็น .env แล้วกรอกค่า)
# ==========================================================
PORT=5000

# ----- เลือกฐานข้อมูล: local (XAMPP ในเครื่อง) | remote (เซิร์ฟเวอร์อาจารย์/ภายนอก) -----
DB_PROFILE=local

# XAMPP (ค่าเริ่มต้นของ XAMPP: user root ไม่มีรหัสผ่าน)
DB_LOCAL_HOST=localhost
DB_LOCAL_PORT=3306
DB_LOCAL_USER=root
DB_LOCAL_PASSWORD=
DB_LOCAL_NAME=db244

# Remote server
DB_REMOTE_HOST=your-server-host
DB_REMOTE_PORT=3306
DB_REMOTE_USER=your-user
DB_REMOTE_PASSWORD=your-password
DB_REMOTE_NAME=db244
DB_REMOTE_SSL=false
# DB_REMOTE_SSL_REJECT_UNAUTHORIZED=false

# รัน migration อัตโนมัติตอนเปิด server (true/false)
DB_AUTO_MIGRATE=true
# อนุญาตให้สร้างฐานข้อมูลเองถ้ายังไม่มี (remote มักไม่มีสิทธิ์ ค่าเริ่มต้นจึงเป็น false)
# DB_CREATE_DATABASE=true

# ----- อีเมลสำหรับส่ง OTP (Gmail App Password) -----
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
